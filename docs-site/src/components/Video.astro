---
// Vídeo curto do R2 (MP4 H.264 com capa WebP). Nunca toca sozinho.
import { MIDIA_BASE } from '../../scripts/midia.mjs';

interface Props { src: string; poster: string; legenda?: string }
const { src, poster, legenda } = Astro.props;
---
<figure class="soci-video">
  <video controls preload="none" playsinline poster={`${MIDIA_BASE}/${poster}`}>
    <source src={`${MIDIA_BASE}/${src}`} type="video/mp4" />
  </video>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .soci-video { margin: 1rem 0; }
  .soci-video video { display: block; width: 100%; height: auto; border-radius: 0.5rem; background: var(--sl-color-black); }
  .soci-video figcaption { margin-top: 0.4rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
