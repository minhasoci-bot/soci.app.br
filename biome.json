{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["*.mjs", "api/**", "routes/**", "scripts/**", "test/**", "ui/*.js", "!ui/vendor", "!ui/locales"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
