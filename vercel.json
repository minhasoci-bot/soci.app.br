{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs-site'",
  "cleanUrls": false,
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "ui/**"
    },
    "server.mjs": {
      "includeFiles": "ui/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs?__path=/$1"
    }
  ]
}
