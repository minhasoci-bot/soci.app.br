{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "buildCommand": "npm run vercel-build",
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "ui/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs?__path=/$1"
    }
  ]
}
