# Server configuration. GO_STORAGE_KEY must match the hash in the Supabase RLS policy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
GO_STORAGE_KEY=

# Optional. Set both variables to enable model generation in AI Studio.
STUDIO_OPENAI_API_KEY=
STUDIO_OPENAI_MODEL=
# Optional. Enable Places API (New) and Geocoding API in Google Cloud.
PROSPECTING_GOOGLE_PLACES_KEY=
# Optional. Use a separate browser key restricted to Maps Embed API and the app's website.
PROSPECTING_GOOGLE_MAPS_EMBED_KEY=

# Optional. UUID of the confirmed Supabase Auth user who owns the shared agency.
GO_AGENCY_OWNER_ID=

# Local development only.
# GO_PORT=4317
# GO_DB_PATH=.data/go.sqlite
# GO_DEV_NO_AUTH=1

# Social planner. On Vercel, call GET /api/social/cron every minute with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Public origin used for media URLs and OAuth callbacks, e.g. https://app.example.com
SOCIAL_PUBLIC_URL=
# Token encryption key. Defaults to a key derived from GO_STORAGE_KEY.
SOCIAL_TOKEN_KEY=
# Optional API version overrides.
# META_GRAPH_VERSION=v23.0
# LINKEDIN_API_VERSION=202510

# Social network apps. Leave a pair empty to disable that network.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
