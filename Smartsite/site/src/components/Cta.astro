---
import { LOGIN_URL } from '../config';

interface Props {
  kind: 'comecar' | 'planos' | 'link';
  href?: string;
  label?: string;
  variant?: 'primary' | 'secondary';
}
const { kind, href, label, variant = kind === 'comecar' ? 'primary' : 'secondary' } = Astro.props;
const target = kind === 'comecar' ? LOGIN_URL : kind === 'planos' ? '/planos/' : href;
const text = kind === 'comecar' ? 'Começar com a soci' : kind === 'planos' ? 'Ver os planos' : label;
const arrow = '<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>';
---
<a class={`btn btn--${variant}`} href={target} data-cta={kind}>{text}{variant === 'primary' && <Fragment set:html={arrow} />}</a>
