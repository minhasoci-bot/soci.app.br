---
import NAV from '../data/nav.json';
import { LOGIN_URL } from '../config';

interface Props { current?: string }
const { current } = Astro.props;
const chev = '<svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Pular para o conteúdo</a>
    <a class="nav__logo" href="/"><img class="logo-mark" src="/brand/soci.svg" alt="" width="28" height="28" />soci</a>
    <nav class="nav__links" aria-label="Principal">
      {NAV.primary.map((item) => (
        <div class="nav__item">
          <a class="nav__link" href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}{item.groups && <Fragment set:html={chev} />}
          </a>
          {item.groups && (
            <div class="nav__menu">
              <div class="wrap grid">
                {item.groups.map((group) => (
                  <div class="menu-col span-3">
                    <p class="t-label">{group.title}</p>
                    {group.links.map((link) => (
                      <a href={link.href}>{link.label}<span>{link.note}</span></a>
                    ))}
                  </div>
                ))}
                <a class="menu-card span-3 start-10" href="/funcionalidades/">
                  <span class="t-card">Todas as funcionalidades</span>
                  <span class="t-small muted">Dezessete partes de uma plataforma só, filtradas pelo que você quer resolver.</span>
                </a>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href={LOGIN_URL} data-cta="entrar">Entrar</a>
      <a class="btn btn--primary" href={LOGIN_URL} data-cta="comecar">Começar com a soci</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>
