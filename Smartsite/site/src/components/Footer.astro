---
import NAV from '../data/nav.json';
import { LOGIN_URL } from '../config';
const year = new Date().getFullYear();
---
<footer class="footer closing footer--statement" id="contato-rodape" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Comece pelo seu primeiro cliente.</h2>
        <p>Você entra com a conta Google e a soci cria o espaço da sua agência na hora.</p>
      </div>
      <a class="btn btn--primary btn--xl btn--wide" href={LOGIN_URL} data-cta="comecar">Começar com a soci<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8" /><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5" /></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/"><img class="logo-mark" src="/brand/soci.svg" alt="" width="28" height="28" />soci</a>
          <p class="footer__lede">A plataforma brasileira para Marketing 360: CRM, sites, WhatsApp, redes sociais, automações e IA no mesmo lugar.</p>
        </div>
        {NAV.footer.map((col) => (
          <div class="span-2 footer__col">
            <h3>{col.title}</h3>
            <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="footer__legal">
        <span>&copy; {year} soci &nbsp; <a href="/privacidade/">Privacidade</a> &nbsp; <a href="/termos/">Termos</a></span>
        <div class="socials">
          <a href="https://www.instagram.com/minhasoci/" rel="me">Instagram</a>
          <a href="https://www.youtube.com/@minhasoci" rel="me">YouTube</a>
        </div>
      </div>
    </div>
  </div>
</footer>
