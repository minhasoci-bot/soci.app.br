---
import { SITE_URL, MARKER } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** href do item do menu desta página (marca aria-current). */
  current?: string;
  /** Página com momento "word-highlight" (só a home). */
  moments?: string[];
}

const { title, description, noindex = false, jsonLd = [], current, moments = [] } = Astro.props;
const canonical = SITE_URL + Astro.url.pathname;
// Página com informação pendente ([[...]]) nunca vai para o Google.
const body = await Astro.slots.render('default');
const hidden = noindex || body.includes(MARKER);
---
<!doctype html>
<html lang="pt-BR" data-type="software" data-radius="soft" data-ground="sand" data-buttons="solid" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hidden && <meta name="robots" content="noindex, follow" />}
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="soci" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE_URL + '/share.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf8f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <link rel="stylesheet" href="/assets/ui/base.css" />
    <style is:inline>
      :root {
        --p-bg: #faf8f7; --p-surface: #f3eef0; --p-ink: #1c1519; --p-muted: #655b61;
        --p-accent: #b8008a; --p-accent-ink: #faf8f7; --p-action: #b8008a; --p-action-ink: #faf8f7;
        --p-inv-bg: #1c1519; --p-inv-surface: #292226; --p-inv-ink: #faf8f7; --p-inv-muted: #9d999a;
        --p-inv-accent: #faf8f7; --p-inv-accent-ink: #1c1519; --p-inv-action: #faf8f7; --p-inv-action-ink: #1c1519;
        --font-display: "Familjen Grotesk", system-ui, sans-serif;
        --font-text: "Familjen Grotesk", system-ui, sans-serif;
        --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        --display-weight: 400;
        --display-tracking: -0.03em;
        --display-tracking-xl: -0.04em;
      }
    </style>
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
    {moments.length > 0 && (
      <Fragment>
        <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
        <link rel="modulepreload" href="/assets/moments/moments.js" />
        <link rel="modulepreload" href="/assets/moments/lib.js" />
        {moments.map((id) => <link rel="modulepreload" href={`/assets/moments/${id}/moment.js`} />)}
      </Fragment>
    )}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <Header current={current} />
    <Fragment set:html={body} />
    <Footer />
    <script type="module" is:inline src="/assets/system.js"></script>
    <script type="module" is:inline src="/assets/motion/motion.js"></script>
    <script type="module" is:inline src="/assets/layout/layout.js"></script>
  </body>
</html>
