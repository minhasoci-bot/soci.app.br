---
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';

interface Props { entry: CollectionEntry<'solucoes'> }
const { entry } = Astro.props;
const d = entry.data;
const funcs = await getEntries(d.funcionalidades);
---
<Base title={d.title} description={d.description} current="/solucoes/">
  <main id="top">
    <section class="section page-head" aria-labelledby="page-h">
      <div class="wrap">
        <Breadcrumbs trail={[{ label: 'Início', href: '/' }, { label: 'Soluções', href: '/solucoes/' }, { label: d.nome, href: `/solucoes/${entry.id}/` }]} />
        <h1 id="page-h">{d.h1}</h1>
        <p class="answer">{d.resposta}</p>
        <div class="btn-row"><Cta kind="comecar" /><Cta kind="planos" /></div>
      </div>
    </section>

    <section class="section" id="como" aria-labelledby="como-h">
      <div class="wrap grid">
        <div class="span-4"><h2 id="como-h">Como a soci resolve</h2></div>
        <div class="span-8 prose-soci"><slot /></div>
      </div>
    </section>

    <section class="section" id="funcionalidades" aria-labelledby="funcs-h">
      <div class="wrap">
        <div class="section-head"><h2 id="funcs-h">Funcionalidades usadas aqui</h2></div>
        <ul class="feature-grid">
          {funcs.map((f) => (
            <li>
              <a class="card feature-card" href={`/funcionalidades/${f.id}/`}>
                <h3>{f.data.nome}</h3>
                <p>{f.data.resumo}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Faq items={d.faq} />
  </main>
</Base>
