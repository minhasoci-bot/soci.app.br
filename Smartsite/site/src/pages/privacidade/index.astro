---
import Core from '../../layouts/Core.astro';
import raw from '../../data/privacidade.html?raw';

// Texto oficial já publicado em soci.app.br/privacidade (ui/privacidade.html), sem alterações.
// O H1 do original vira o H1 do layout; os demais títulos descem um nível para manter a hierarquia.
const corpo = raw
  .replace(/<h1>[\s\S]*?<\/h1>/, '')
  .replace(/<h2>/g, '<h2 class="t-h3">');
---
<Core
  title="Política de Privacidade da soci"
  description="Quais dados pessoais a soci coleta, para que usa, com quem compartilha e quais direitos você tem, conforme a LGPD."
  h1="Política de Privacidade"
  crumb="Privacidade"
  href="/privacidade/"
>
  <section class="section" aria-label="Texto da política">
    <div class="wrap"><div class="legal prose-soci" set:html={corpo} /></div>
  </section>
</Core>
