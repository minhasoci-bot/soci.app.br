---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { SITE_URL } from '../config';

const funcs = (await getCollection('funcionalidades')).sort((a, b) => a.data.ordem - b.data.ordem);

const etapas = [
  {
    id: 'atrair', tab: 'Atrair clientes', screen: 'marketing',
    alt: 'Planejador social da soci com nove redes para conectar',
    texto: 'Posts em nove redes no mesmo calendário, site feito com IA e uma lista de empresas do seu nicho tirada do Google Maps.',
    links: [['redes-sociais', 'Redes sociais'], ['sites', 'Sites com IA'], ['prospeccao', 'Prospecção']],
  },
  {
    id: 'converter', tab: 'Converter leads', screen: 'oportunidades',
    alt: 'Funil de oportunidades da soci por etapas',
    texto: 'O lead do formulário ou da landing page entra no funil, recebe a primeira mensagem sozinho e você vê quem está perto de fechar.',
    links: [['crm', 'CRM'], ['funis-e-landing-pages', 'Funis e landing pages'], ['automacoes', 'Automações']],
  },
  {
    id: 'atender', tab: 'Atender clientes', screen: 'agentes',
    alt: 'Estúdio de agentes de IA da soci com casos de uso prontos, como atendimento ao cliente',
    texto: 'WhatsApp, Instagram, Messenger, e-mail e o chat do site numa caixa só. Agentes de IA e telefone com Voice AI ajudam no volume.',
    links: [['whatsapp-e-atendimento', 'WhatsApp e atendimento'], ['inteligencia-artificial', 'Inteligência artificial'], ['telefone-e-voz', 'Telefone e voz']],
  },
  {
    id: 'reter', tab: 'Trazer de volta', screen: 'contatos',
    alt: 'Lista de contatos da soci com tags',
    texto: 'E-mail pelo seu domínio para quem sumiu, pedido de avaliação depois do atendimento e área de membros para quem já comprou.',
    links: [['email-marketing', 'E-mail marketing'], ['reputacao', 'Reputação'], ['cursos-e-area-de-membros', 'Cursos e área de membros']],
  },
  {
    id: 'gerir', tab: 'Gerir a agência', screen: 'painel',
    alt: 'Painel de controle da soci com status e valor das oportunidades e taxa de conversão',
    texto: 'Uma subconta por cliente, relatórios com link público e o painel da agência com a receita recorrente de todas elas.',
    links: [['gestao-de-agencias', 'Gestão de agências'], ['relatorios', 'Relatórios']],
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'soci', url: SITE_URL,
    logo: SITE_URL + '/brand/soci-isotipo.png',
    sameAs: ['https://www.instagram.com/minhasoci/', 'https://www.youtube.com/@minhasoci'],
  },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'soci',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', inLanguage: 'pt-BR',
    url: SITE_URL, description: 'A plataforma brasileira para Marketing 360: CRM, WhatsApp, sites com IA, redes sociais, automações e pagamentos via Pix.',
  },
];
const arrow = '<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>';
---
<Base
  title="soci: a plataforma brasileira para Marketing 360"
  description="CRM, WhatsApp, sites com IA, nove redes sociais, automações e Pix numa plataforma brasileira, com suporte em português e calls todos os dias."
  jsonLd={jsonLd}
  moments={['word-highlight']}
>
  <main id="top">
    <section class="hero hero--collage" data-enter aria-labelledby="hero-h">
      <div class="wrap"><div class="hero-text grid hero__grid">
        <div class="hero__text span-5">
          <h1 id="hero-h">A plataforma brasileira para Marketing 360.</h1>
          <p class="hero__lead">Tudo que seu marketing precisa. Inclusive bom gosto. CRM, WhatsApp, sites com IA, nove redes sociais e automações com 137 gatilhos num lugar só.</p>
          <div class="btn-row">
            <Cta kind="comecar" />
            <a class="btn btn--secondary" href="/planos/" data-cta="planos">Ver os planos</a>
          </div>
          <p class="hero__proof">Suporte brasileiro. Calls todos os dias. Comunidade ativa. Receba via Pix.</p>
        </div>
        <div class="hero__art span-6 start-7" role="img" aria-label="Funil de oportunidades da soci e, em destaque, um exemplo ilustrativo de automação: lead do formulário recebe WhatsApp e entra no funil">
          <div class="ly-piece ly-piece--main hero-shot" aria-hidden="true">
            <img src="/produto/oportunidades.webp" alt="" width="1440" height="900" fetchpriority="high" />
          </div>
          <div class="ly-piece ly-piece--note note-card" aria-hidden="true" data-ly-steps="700">
            <div class="note-card__head"><b>Novo lead pelo formulário</b><span class="note-chip" data-step data-step-at="4">Exemplo</span></div>
            <div class="note-card__line" data-step><i>1</i><span><b>Ana Martins</b> entrou pelo site</span></div>
            <div class="note-card__line" data-step><i>2</i><span>WhatsApp de boas-vindas <b>enviado</b></span></div>
            <div class="note-card__line" data-step><i>3</i><span>Oportunidade em <b>Novo lead</b></span></div>
          </div>
        </div>
      </div></div>
    </section>

    <section class="section" id="jornada" aria-labelledby="jornada-h">
      <div class="wrap grid tour">
        <div class="span-5 stack-6">
          <div class="section-head">
            <h2 id="jornada-h">Marketing 360 em cinco etapas. <span class="muted">Cada uma com as partes da soci que resolvem.</span></h2>
            <p class="tour__hubs"><a class="link" href="/funcionalidades/">Ver as {funcs.length} funcionalidades</a><a class="link" href="/solucoes/">Ver soluções por negócio</a></p>
          </div>
          <div class="tabs" role="tablist" aria-label="Etapas do Marketing 360">
            {etapas.map((e, i) => (
              <button class="tab" type="button" role="tab" id={`tab-${e.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`painel-${e.id} tela-${e.id}`}>{e.tab}</button>
            ))}
          </div>
          {etapas.map((e) => (
            <div class="tour__panel" role="tabpanel" id={`painel-${e.id}`} aria-labelledby={`tab-${e.id}`}>
              <p>{e.texto}</p>
              <ul class="tour__links">
                {e.links.map(([slug, nome]) => <li><a class="link" href={`/funcionalidades/${slug}/`}>{nome}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="frame frame--split span-6 start-7 tour__frame">
          {etapas.map((e) => (
            <div class="tour__screen" id={`tela-${e.id}`}>
              <img src={`/produto/${e.screen}.webp`} alt={e.alt} width="1440" height="900" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section statement" id="por-que" data-moment="word-highlight" aria-label="Por que a soci">
      <div class="wrap">
        <p class="t-label">Por que a soci</p>
        <p class="mo-wh__text">Marketing 360 não deveria custar 360 assinaturas. Na soci, o CRM, o WhatsApp, os sites, as redes e as automações são <strong>uma plataforma só</strong>, em português e com gente de verdade no suporte.</p>
      </div>
    </section>

    <section class="section ground-inverse" id="gente" aria-labelledby="gente-h">
      <div class="wrap grid split-top">
        <div class="span-6 stack-6">
          <div class="section-head">
            <h2 id="gente-h">Suporte brasileiro e Pix. <span class="muted">Porque estamos no Brasil.</span></h2>
          </div>
          <div class="perks">
            <article class="perk"><h3>Atende em português</h3><p>Gente do Brasil atendendo, sem tradução no meio do caminho.</p></article>
            <article class="perk"><h3>Tira dúvidas em call todo dia</h3><p>Dúvidas acontecem todo dia. As calls de suporte também.</p></article>
            <article class="perk"><h3>Reúne clientes numa comunidade</h3><p>Você não precisa descobrir tudo sozinho. Ainda bem.</p></article>
            <article class="perk"><h3>Recebe via Pix e cartão</h3><p>Faturas, orçamentos e loja com Pix ou cartão pela AbacatePay.</p></article>
          </div>
          <div class="btn-row"><a class="btn btn--secondary" href="/suporte/">Ver como funciona o suporte</a></div>
        </div>
        <div class="span-6 start-7 mascot-frame">
          <img src="/brand/soci-animado.svg" alt="Mascote da soci, uma caveira sorridente em chamas cor-de-rosa, piscando" width="360" height="360" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section" id="agencias" aria-labelledby="agencias-h">
      <div class="wrap grid split-top">
        <div class="span-5 stack-5">
          <h2 id="agencias-h">Feita para agências com muitos clientes</h2>
          <ul class="does">
            <li><b>Uma subconta por cliente</b><span>CRM, conversas, sites e relatórios separados.</span></li>
            <li><b>Setups prontos</b><span>Funis, automações e páginas instalados num cliente novo.</span></li>
            <li><b>Modo SaaS</b><span>Planos, margem e cobrança das subcontas via Pix.</span></li>
            <li><b>App com a sua marca</b><span>Nome e cores da agência no aplicativo do cliente.</span></li>
          </ul>
          <p><a class="link" href="/solucoes/agencias/">Ver a soci para agências</a></p>
        </div>
        <div class="span-6 start-7">
          <figure class="screen"><img src="/produto/setups.webp" alt="Setups de conta da soci para instalar estruturas prontas em subcontas" width="1440" height="900" loading="lazy" decoding="async" /></figure>
        </div>
      </div>
    </section>


  </main>
</Base>
