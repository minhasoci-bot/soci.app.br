---
import Core from '../../layouts/Core.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';

const comecar = [
  { q: 'A soci é fácil de usar?', a: 'Foi feita para ser. Você entra com a conta Google, a soci cria o espaço da sua agência no primeiro acesso e o WhatsApp conecta por QR Code. Se travar em algo, as calls de suporte acontecem todos os dias.' },
  { q: 'Como trago meus contatos e minha estrutura atual?', a: 'Os contatos entram por importação no CRM. Para estruturas prontas de funis, automações e páginas, você instala um setup numa subconta nova.' },
  { q: 'Os sites ficam bons no celular?', a: 'Sim. O estúdio monta as páginas pensando primeiro no celular. Aparentemente, as pessoas usam celular.' },
  { q: 'A soci se integra com outras ferramentas?', a: 'Sim. São 27 apps conectáveis nas automações, além de webhooks e de uma API pública para contatos e subcontas.' },
];
const dinheiro = [
  { q: 'Quanto custa a soci?', a: 'Os valores e o que entra em cada plano ficam na <a class="link" href="/planos/">página de planos</a>.' },
  { q: 'Dá para receber pagamentos via Pix?', a: 'Sim. Seus clientes pagam via Pix ou cartão num checkout da AbacatePay, a partir de faturas, orçamentos, loja ou planos. Taxas e prazos são os da AbacatePay.' },
  { q: 'Como funciona o cancelamento?', a: 'As regras de cancelamento são publicadas junto com os planos, na página de planos.' },
];
const ajuda = [
  { q: 'O suporte é brasileiro?', a: 'Sim. O suporte é totalmente brasileiro, em português, e há calls de suporte todos os dias.' },
  { q: 'Existe uma comunidade de clientes?', a: 'Sim. Clientes participam de um grupo para trocar o que funciona; o acesso fica dentro da plataforma.' },
  { q: 'Meus dados e os dos meus clientes ficam seguros?', a: 'Cada subconta é isolada das outras, o acesso é feito com a conta Google e cada pessoa da equipe tem permissões próprias. A <a class="link" href="/privacidade/">política de privacidade</a> explica como tratamos os dados conforme a LGPD.' },
];
const todas = [...comecar, ...dinheiro, ...ajuda];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: todas.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') } })) };
---
<Core
  title="Perguntas frequentes sobre a soci"
  description="Respostas diretas sobre a soci: facilidade de uso, migração, sites no celular, integrações, Pix, suporte, comunidade, segurança e planos."
  h1="Perguntas frequentes sobre a soci"
  lead="Respostas curtas para o que mais perguntam antes de começar."
  crumb="Perguntas frequentes"
  href="/perguntas-frequentes/"
>
  <Faq id="comecar" title="Começar e migrar" items={comecar} jsonLd={false} />
  <Faq id="dinheiro" title="Planos, Pix e cancelamento" items={dinheiro} jsonLd={false} />
  <Faq id="ajuda" title="Suporte, comunidade e segurança" items={ajuda} jsonLd={false} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="section" aria-label="Começar">
    <div class="wrap"><div class="btn-row"><Cta kind="comecar" /><Cta kind="planos" /></div></div>
  </section>
</Core>
